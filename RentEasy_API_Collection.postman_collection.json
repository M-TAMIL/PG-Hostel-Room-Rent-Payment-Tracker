{
  "info": {
    "name": "RentEasy - PG & Hostel Rent Payment Tracker API",
    "description": "Comprehensive Postman collection covering all 5 core features, business rules, edge cases, error cases, and dashboard stats for RentEasy.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Tenant Management",
      "item": [
        {
          "name": "Feature 1: Register Tenant & Assign Room (Success)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Kavitha Sundaram\",\n  \"phone\": \"9876543299\",\n  \"email\": \"kavitha@example.com\",\n  \"moveInDate\": \"2026-01-01\",\n  \"roomId\": 2,\n  \"monthlyRent\": 8500.0,\n  \"securityDeposit\": 17000.0\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/tenants",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tenants"]
            }
          }
        },
        {
          "name": "Rule 1 Edge Case: Register Tenant to OCCUPIED Room (Expect 409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Imposter Tenant\",\n  \"phone\": \"9876541111\",\n  \"email\": \"imposter@example.com\",\n  \"moveInDate\": \"2026-03-01\",\n  \"roomId\": 1,\n  \"monthlyRent\": 8000.0,\n  \"securityDeposit\": 16000.0\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/tenants",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tenants"]
            }
          }
        },
