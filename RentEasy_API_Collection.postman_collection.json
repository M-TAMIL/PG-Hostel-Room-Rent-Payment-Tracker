          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/tenants/1/vacate",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "tenants", "1", "vacate"]
            }
          }
        },
        {
          "name": "List All Tenants (Filter Active)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/api/tenants?status=ACTIVE",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
